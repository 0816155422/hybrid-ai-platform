{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hap/schemas/raw-artifact-envelope-0.1.0.json",
  "title": "HAP Raw Artifact Envelope",
  "description": "Draft schema for a read-only Phase 0 local collection result. The identifier is a placeholder and must not be treated as a published canonical schema URI.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "project_id",
    "phase",
    "source_locator",
    "source_version",
    "captured_at_utc",
    "original_filename",
    "media_type",
    "byte_size",
    "hash_algorithm",
    "sha256",
    "authorization_ref",
    "collection_status",
    "transformation_status",
    "derived_from",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "artifact_id": { "type": "string", "minLength": 1 },
    "project_id": { "const": "HAP-2026-OFFLINE-FIRST" },
    "phase": { "const": "PHASE_0_DOCUMENTATION_AND_GOVERNANCE_REVIEW" },
    "source_locator": { "type": "string", "minLength": 1 },
    "source_version": { "type": "string", "minLength": 1 },
    "captured_at_utc": { "type": "string", "format": "date-time" },
    "original_filename": { "type": "string", "minLength": 1 },
    "media_type": { "type": "string", "minLength": 1 },
    "byte_size": { "type": "integer", "minimum": 0 },
    "hash_algorithm": { "const": "SHA-256" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "authorization_ref": { "type": "string", "minLength": 1 },
    "collection_status": { "const": "COLLECTED_UNVERIFIED" },
    "transformation_status": { "const": "NONE" },
    "derived_from": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
